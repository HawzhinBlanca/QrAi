{
  "title": "QrAi HTTP canary",
  "uid": "qrai-http-canary",
  "schemaVersion": 39,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Node request rate by status",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"node-api\"}[5m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Node 5xx rate",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"node-api\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"node-api\"}[5m])), 1)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Node latency p50 / p95 / p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_ms_bucket{job=\"node-api\"}[5m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_ms_bucket{job=\"node-api\"}[5m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_ms_bucket{job=\"node-api\"}[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Node fallback share",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "percentunit" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{job=\"node-api\",path=\"<unmatched>\"}[5m])) / clamp_min(sum(rate(http_requests_total{job=\"node-api\"}[5m])), 1)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Durable job states",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "job_state{job=\"job-worker\",status=\"queued\"}", "legendFormat": "queued" },
        { "refId": "B", "expr": "job_state{job=\"job-worker\",status=\"retry\"}", "legendFormat": "retry" },
        { "refId": "C", "expr": "job_state{job=\"job-worker\",status=\"dead\"}", "legendFormat": "dead" }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Stored audio not indexed",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "realtime_gateway_chunks_stored_unindexed_total{job=\"realtime-gateway\"}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Canary component readiness",
      "gridPos": { "h": 8, "w": 18, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"node-api\"}", "legendFormat": "node-api" },
        { "refId": "B", "expr": "up{job=\"job-worker\"}", "legendFormat": "job-worker" },
        { "refId": "C", "expr": "up{job=\"platform-api\"}", "legendFormat": "platform-api" },
        { "refId": "D", "expr": "up{job=\"realtime-gateway\"}", "legendFormat": "realtime-gateway" }
      ]
    }
  ]
}
